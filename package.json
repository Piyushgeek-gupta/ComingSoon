{
  "name": "nookaa-waitlist",
  "version": "1.0.0",
  "private": true,
  "description": "Nookaa — Beverages & Beyond: coming-soon landing page with a waitlist backed by a private Google Sheet.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server/server.js && node --check server/routes/waitlist.js && node --check server/services/googleSheets.js",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "gen:credentials": "node -e \"const f=process.argv[1];if(!f){console.error('usage: npm run gen:credentials -- ./service-account.json');process.exit(1)}console.log(require('fs').readFileSync(f).toString('base64'))\""
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "serverless-http": "^4.0.0",
    "validator": "^13.12.0"
  },
  "keywords": [
    "nookaa",
    "waitlist",
    "express",
    "google-sheets"
  ],
  "license": "UNLICENSED"
}
