# =========================================================
# NOOKAA — environment template
#
# Copy to .env and fill in.  The real .env is gitignored and must
# never be committed, pasted into a ticket, or shipped in a zip.
#
#   cp .env.example .env
# =========================================================

# ---- Server ----
PORT=3000
NODE_ENV=development

# How many reverse proxies sit in front of this app.
#   0  no proxy (local dev, plain VPS)
#   1  Render / Railway / Fly / a single nginx
# Setting this HIGHER than reality lets anyone forge X-Forwarded-For
# and bypass the rate limiter. When unsure, leave it at 0.
TRUST_PROXY_HOPS=0

# Redirect http -> https. Defaults to on in production.
FORCE_HTTPS=

# Only needed if the landing page is hosted somewhere else (Netlify,
# Vercel, S3) and calls this API cross-origin. Comma separated, full
# origins including scheme. LEAVE BLANK for same-origin: blank means
# no cross-origin browser may read this API at all.
ALLOWED_ORIGINS=

# ---- Google Sheets ----
# 1. Google Cloud Console -> enable "Google Sheets API"
# 2. IAM -> Service Accounts -> create one -> Keys -> Add key -> JSON
# 3. Share the spreadsheet with the service account email, role Editor
# 4. Sheet ID is the middle part of the sheet URL:
#    https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Waitlist

# Preferred: the whole downloaded JSON key, base64 encoded. One opaque
# value, no newline mangling by the host's env editor.
#   npm run gen:credentials -- ./service-account.json
GOOGLE_CREDENTIALS_BASE64=

# Alternative to the above. Use one or the other, not both.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# Give up on a slow Google call after this many ms.
GOOGLE_TIMEOUT_MS=10000

# ---- Duplicate index ----
# Random secret used to fingerprint addresses in memory so the plaintext
# list is never held in the process heap. REQUIRED in production.
#   npm run gen:secret
EMAIL_HASH_SECRET=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300

# Minimum duration of every POST /api/waitlist response, in ms. Makes a
# duplicate address take exactly as long as a new one, closing the timing
# side channel. Do not set to 0 in production.
RESPONSE_FLOOR_MS=700

# ---- Disclosure controls ----
# true  -> a repeat signup gets {"success":false,"message":"Already Joined"}
#          which also lets anyone test whether an address is on the list.
# false -> repeat and new signups are indistinguishable. Recommended.
REVEAL_DUPLICATES=false

# Exposes GET /api/waitlist/count, which leaks the size of the list.
# Off by default; the page falls back to its static "2,000+" copy.
PUBLIC_COUNT_ENABLED=false
WAITLIST_DISPLAY_BASE=0
PUBLIC_COUNT_TTL_MS=300000

# ---- Local fallback spool ----
# Where signups go when Google credentials are absent. This is a second
# plaintext copy of personal data, so it is off in production by default;
# there, a Sheets outage returns a clean 503 instead.
FALLBACK_STORE_ENABLED=
FALLBACK_STORE_PATH=./data/waitlist.jsonl
